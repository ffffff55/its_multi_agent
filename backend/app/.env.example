# 复制为 .env 后填写真实值，不要把填好的 .env 提交到 Git。
# 至少配置「硅基流动」或「阿里百炼」其中一套，否则启动校验失败。
# 当前调度和两个专家用的是阿里百炼上的 SUB_MODEL_NAME。
# 只配硅基流动时进程能起来，对话请求会失败。

# 硅基流动
SF_API_KEY=
SF_BASE_URL=

# 阿里百炼
AL_BAILIAN_API_KEY=
AL_BAILIAN_BASE_URL=

# 模型
MAIN_MODEL_NAME=Qwen/Qwen3-32B
SUB_MODEL_NAME=

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=its_db

# 知识库服务
KNOWLEDGE_BASE_URL=

# 通义千问搜索
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=

# 百度地图
BAIDUMAP_AK=
